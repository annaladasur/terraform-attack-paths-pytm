            "https://avd.aquasec.com/misconfig/aws-0090"
          ],
          "Resolution": "Enable versioning to protect against accidental/malicious removal or modification",
          "Severity": "MEDIUM",
          "Status": "FAIL",
          "Title": "S3 Data should be versioned",
