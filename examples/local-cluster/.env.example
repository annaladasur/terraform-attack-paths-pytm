# TAPM Local Cluster Environment Configuration (W2.3a)
# Copy to .env or let bootstrap.sh generate it automatically

# Local cluster settings
CLUSTER_NAME=tapm-lab
K8S_PROVIDER=kind             # 'kind' or 'k3d'

# Gitea configuration
GITEA_URL=http://localhost:3000
GITEA_ADMIN_USER=tapm-admin
GITEA_ADMIN_PASSWORD=tapm-admin-pass123
GITEA_ADMIN_EMAIL=admin@tapm.local
GITEA_ORG=demo-org
GITEA_REPO=infra-demo
REQUIRED_CHECK=attack-paths

# Authentication tokens
TAPM_SERVER_TOKEN=demo-secret-token
GITEA_TOKEN=
GITEA_RUNNER_TOKEN=

# Internal cluster URLs
TAPM_SERVER_URL=http://tapm-service.tapm.svc.cluster.local:8080
GITEA_INTERNAL_URL=http://gitea.git.svc.cluster.local:3000

# Model runtime (host-based)
TAPM_LLM=simulated            # 'simulated', 'ollama', or 'anthropic'
OLLAMA_HOST=http://host.k3d.internal:11434
