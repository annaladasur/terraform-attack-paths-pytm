# TAPM Local Stack Environment Configuration
# Copy to .env or let bootstrap.sh generate it automatically.

# Gitea Git Server Configuration
GITEA_URL=http://localhost:3000
GITEA_ADMIN_USER=tapm-admin
GITEA_ADMIN_PASSWORD=tapm-admin-pass123
GITEA_ADMIN_EMAIL=admin@tapm.local
GITEA_SECRET_KEY=local-stack-tapm-secret-key-32chars

# Organization and Demo Repository
GITEA_ORG=demo-org
GITEA_REPO=infra-demo
REQUIRED_CHECK=attack-paths

# Generated Credentials (auto-filled by bootstrap.sh)
GITEA_TOKEN=
GITEA_RUNNER_TOKEN=

# Analysis Service (tapm serve) Configuration
TAPM_SERVER_URL=http://localhost:8080
TAPM_SERVER_TOKEN=demo-secret-token
TAPM_LLM=simulated
TAPM_JEV=local
TAPM_MODEL=

# Host LLM Runtime (for Ollama on macOS host)
OLLAMA_HOST=http://host.docker.internal:11434
